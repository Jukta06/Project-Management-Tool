# Server Configuration
PORT=5000
NODE_ENV=development

# PostgreSQL Database Configuration (Neon)
DATABASE_URL=postgresql://username:password@your-neon-host/neondb?sslmode=require&channel_binding=require
DB_SSL=true
DB_LOGGING=false

# JWT Secret
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRE=7d

# Frontend URL(s) for CORS (comma separated)
CLIENT_URLS=http://localhost:5173,https://your-frontend-domain.com

# Email Configuration (Optional)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_email_password

# Socket.io Configuration
SOCKET_PORT=5001
